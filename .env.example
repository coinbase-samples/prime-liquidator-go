# Copy to .env and fill in your values: cp .env.example .env
#
# Prime API credentials (single-line JSON). Create keys in the Prime web app.
# Never commit a real .env file.
PRIME_CREDENTIALS={"accessKey":"YOUR_ACCESS_KEY","passphrase":"YOUR_PASSPHRASE","signingKey":"YOUR_SIGNING_KEY","portfolioId":"YOUR_PORTFOLIO_ID","svcAccountId":"YOUR_SERVICE_ACCOUNT_ID"}

# local | dev | prod — local enables safer defaults
ENV_NAME=local

# When true (default), the liquidator logs intended orders/conversions but does not submit them.
DRY_RUN=true

# Fiat symbol used for sells and stablecoin conversions
FIAT_CURRENCY_SYMBOL=USD

# Comma-separated stablecoin symbols to convert to fiat instead of selling on exchange
CONVERT_SYMBOLS=usdc

# TWAP duration in minutes (minimum 60 per Prime rules)
TWAP_DURATION=60

# Minimum notional per hour for TWAP eligibility (USD)
TWAP_MIN_NOTIONAL=100

# Prime API request timeout (seconds)
PRIME_CALL_TIMEOUT=10

# In-process idempotency cache size for client order IDs
ORDERS_CACHE_SIZE=1000

# Optional: override Coinbase Exchange API base URL (defaults to production)
# COINBASE_EXCHANGE_BASE_URL=https://api.exchange.coinbase.com
